# Wolfgang at his desk: the animated sprite of the app scene.
#
# Pure text so it can be edited pixel by pixel. `.` is transparent.
# Rendered by:  cargo run --release -p wolfgang-art -- build
#
# size W H        canvas of every frame
# origin X Y      where the canvas sits in the 320x180 office
# color C RRGGBB  palette (comment = what it is)
# frame NAME      followed by H rows of W characters
# anim NAME frame:ms frame:ms …   loops; ms 0 = hold the frame

size 46 56
origin 140 52

color O 1c0c16  # outline / eyes
color h 3d2722  # hair shadow
color H 523c2d  # hair
color i 694f40  # hair light
color S e69f5e  # skin
color s d5754c  # skin shade
color L f0ae70  # skin light
color q c66747  # skin shadow
color m a0523c  # lips
color M 5c2b29  # mouth inside
color B 5f442e  # beard
color b 453228  # beard shadow
color g 866754  # beard grey
color G bda799  # glasses frame
color w eddcbf  # lens glint
color Y b4792b  # cardigan mustard
color y 946020  # mustard shade
color V 484f33  # cardigan green
color v 3b3e2e  # green shade / collar
color T 1f222d  # tee
color l 3a3d79  # lanyard blue
color n 438043  # lanyard green
color r c66747  # lanyard red
color P f0e5d2  # paper / mug / badge
color U d5c1b2  # paper shade
color F d99452  # folder
color f b4792b  # folder shade
color c 3d2722  # coffee

anim idle  idle:2600 blink:130 idle:4200 blink:110 idle:180 blink:110
anim talk  talk:150 idle:110 talk:170 smile:140 talk:120 idle:150
anim type  typeA:120 typeB:120 typeA:140 idle:90 typeB:110 typeA:120
anim sip   idle:300 sip:1600 idle:0
anim hand  hand:0
anim happy smile:0

