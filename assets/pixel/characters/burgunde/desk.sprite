# Burgunde at the desk: the animated sprite of the app scene.
#
# Pure text so it can be edited pixel by pixel. `.` is transparent. Also painted as desk.png;
# the build keeps both identical (assets/pixel/README.md).
# Poses (arms, hands, mug, folder) are Wolfgang's, so every animation lines up with the desk.
#
# size W H        canvas of every frame
# origin X Y      where the canvas sits in the 320x180 office
# color C RRGGBB  palette (comment = what it is)
# frame NAME      followed by H rows of W characters
# anim NAME frame:ms frame:ms …   loops; ms 0 = hold the frame

size 46 56
origin 140 52

color O 1c0c16  # outline / eyes
color a 4b3636  # hair darkest / brows
color H 6d544e  # hair dark grey
color h 9c8176  # hair grey
color i cab09d  # hair light
color j ebd6c0  # hair highlight
color k 8d3040  # burgundy streak
color K 571d1e  # burgundy shade
color S cd6946  # skin
color L e18245  # skin light
color s b1563f  # skin shade
color q 90452c  # skin shadow
color m a14a3a  # lips
color M 47171e  # mouth inside
color W ffffff  # teeth
color G 3e2e31  # glasses frame
color w f0e5d1  # lens glint
color E f7bd6a  # gold
color g c48730  # gold shade
color Y 9f5020  # cardigan brown
color y 78301f  # cardigan shade
color Z e88a4e  # zigzag orange
color z c15f42  # zigzag orange shade
color X 5f5c40  # zigzag olive
color x 47442f  # zigzag olive shade
color R 662720  # cardigan ribbing
color T 2f1f29  # tee
color P f0e5d2  # paper / mug
color U d5c1b2  # paper shade
color F d99452  # folder
color f b4792b  # folder shade
color c 3d2722  # coffee

anim idle  idle:2600 blink:130 idle:4200 blink:110 idle:180 blink:110
anim talk  talk:150 idle:110 talk:170 smile:140 talk:120 idle:150
anim type  typeA:120 typeB:120 typeA:140 idle:90 typeB:110 typeA:120
anim sip   idle:300 sip:1600 idle:0
anim hand  hand:0
anim happy smile:0

