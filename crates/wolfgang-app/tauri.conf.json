{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wolfgang",
  "version": "2.3.0",
  "identifier": "de.artismedia.wolfgang",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wolfgang",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "resizable": false,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "backgroundColor": "#2a211c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "public.app-category.graphics-design",
    "copyright": "© artismedia",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "files": {
        "MacOS/wolfgang": "../../target/release/wolfgang",
        "MacOS/ffmpeg": "../../target/ffmpeg/bin/ffmpeg",
        "MacOS/ffprobe": "../../target/ffmpeg/bin/ffprobe",
        "Resources/LICENSE-ffmpeg.txt": "../../target/ffmpeg/LICENSE-ffmpeg.txt"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3M0ZDQjZBMTIxMDJBMkQKUldRdEtoQVNhc3MvdHlILzRDYnVwZ0Q3blVRMEgvdmtsTXVSK0E1emRZSUU3SC9ueU1kM1M1STIK",
      "endpoints": [
        "https://github.com/k1tesurfen/wolfgang/releases/latest/download/latest.json"
      ]
    }
  }
}
